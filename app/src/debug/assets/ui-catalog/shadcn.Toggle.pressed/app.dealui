import * as app from "./app";
import * as ui from "./platform-ui.dealui-pack";
// @ui-root
export view App(state: app.AppState): View {
  ui.AppTheme(style: ui.__STYLE__) {
    ui.Root(spacing: ui.spaceLg, padding: ui.spaceMd, contentWidth: ui.contentCompact) {
      ui.Header(title: "Pin view", supporting: "shadcn Toggle is a pressed button, not a switch")
      ui.ToggleButton(
        label: "Pin this view",
        pressed: state.pinned,
        variant: "outline",
        onChange: action app.ChangePinned { pressed: payload },
        accessibilityLabel: "Pin view toggle"
      )
    }
  }
}
