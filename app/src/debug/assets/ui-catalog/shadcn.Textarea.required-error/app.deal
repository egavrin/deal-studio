export class AppState { notes: string = ""; validationVisible: boolean = true; }
export class ChangeNotes { value: string; }
export class SubmitNotes {}
export function initialState(): AppState { return { notes: "", validationVisible: true }; }
// @ui-update
export function changeNotes(state: AppState, action: ChangeNotes): AppState {
  return { notes: action.value, validationVisible: state.validationVisible };
}
// @ui-update
export function submitNotes(state: AppState, action: SubmitNotes): AppState {
  return { notes: state.notes, validationVisible: true };
}
export function main(): null { return null; }
