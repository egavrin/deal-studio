import * as app from "./app";
import * as ui from "./platform-ui.dealui-pack";
// @ui-root
export view App(state: app.AppState): View {
  ui.AppTheme(style: ui.__STYLE__) {
    ui.Root(spacing: ui.spaceLg, padding: ui.spaceMd, contentWidth: ui.contentCompact) {
      ui.Header(title: "Required note", supporting: "Submit validation is owned by checked DEAL state")
      ui.TextArea(
        name: "notes",
        value: state.notes,
        label: "Notes",
        placeholder: "Write several lines",
        rows: 4,
        required: true,
        requiredMessage: "Notes are required",
        validateOn: ui.validationOnSubmit,
        validationVisible: state.validationVisible,
        onChange: action app.ChangeNotes { value: payload },
        accessibilityLabel: "Notes editor"
      )
      ui.Button(text: "Validate notes", onClick: action app.SubmitNotes {})
    }
  }
}
