import * as app from "./app";
import * as ui from "./platform-ui.dealui-pack";
// @ui-root
export view App(state: app.AppState): View {
  ui.AppTheme(style: ui.__STYLE__) {
    ui.Root(spacing: ui.spaceLg, padding: ui.spaceMd, contentWidth: ui.contentCompact) {
      ui.Header(title: "Digest", supporting: "shadcn Switch with source-compatible required validation")
      ui.Toggle(
        name: "weeklyDigest",
        checked: state.enabled,
        label: "Enable weekly digest",
        required: true,
        requiredMessage: "Enable the digest before continuing",
        validationVisible: state.validationVisible,
        onChange: action app.ChangeEnabled { checked: payload },
        accessibilityLabel: "Digest switch"
      )
    }
  }
}
