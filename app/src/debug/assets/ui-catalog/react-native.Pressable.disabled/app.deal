export class AppState { presses: int = 0; }
export class PressSurface {}
export function initialState(): AppState { return { presses: 0 }; }
// @ui-update
export function pressSurface(state: AppState, action: PressSurface): AppState {
  return { presses: state.presses + 1 };
}
export function main(): null { return null; }
